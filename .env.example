# ============================================================
# Phase 2 server config. Copy to .env.local and fill in.
# Without these, the app falls back to localStorage-only mode.
# ============================================================

# Public toggle: turn server sync on after DB + auth are wired.
NEXT_PUBLIC_FEEDBACK_SYNC=on

# ----- Postgres -----
# Local dev (docker-compose):
DATABASE_URL=postgres://webviewer:webviewer_dev_password@localhost:5432/webviewer
# Coolify prod example:
# DATABASE_URL=postgres://user:password@coolify-host:5432/webviewer

# ----- better-auth -----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
PROJECT_CREATOR_EMAILS=you@example.com

# Google OAuth only. Callback: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- S3 / MinIO -----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=webviewer
S3_SECRET_KEY=webviewer_dev_password
S3_BUCKET=feedback-uploads
# Public base URL for served objects (for share links / markdown previews).
S3_PUBLIC_URL=http://localhost:9000/feedback-uploads
# When using MinIO, force path-style. Set to "false" for AWS.
S3_FORCE_PATH_STYLE=true
